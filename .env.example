# Copy to .env and fill in. Never commit real values.
# Local-only defaults below are throwaway development values.

# Database
POSTGRES_USER=aitms
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=aitms
APP_DB_PASSWORD=change-me-app
# API uses the non-owner role so row-level security applies; migrations use the owner.
DATABASE_URL=postgresql+psycopg://aitms_app:change-me-app@postgres:5432/aitms
MIGRATION_DATABASE_URL=postgresql+psycopg://aitms:change-me-local@postgres:5432/aitms

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage (RustFS locally, any S3-compatible store elsewhere)
S3_ENDPOINT=http://s3:9000
S3_BUCKET=aitms
S3_ACCESS_KEY=change-me-local
S3_SECRET_KEY=change-me-local-secret

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODE=fixture            # live | fixture
LLM_MODEL=gpt-4o-mini
LLM_LIVE_APPROVED=false     # live calls are refused until the organisation approves data handling
AI_AUTHORING_ENABLED=false  # feature flag for AI-assisted course authoring

# Figma (read-only)
FIGMA_TOKEN=

# Auth
JWT_SECRET=                 # required, at least 32 random characters
COOKIE_SECURE=false         # local http only; keep true anywhere served over https

# Password for the seven bootstrap accounts (intern.dev@example.com, trainer@example.com,
# admin@example.com, ...). Required by `seed`, at least 12 characters.
DEMO_PASSWORD=

# Sandbox runner and reference app
SANDBOX_URL=http://sandbox-runner:8100
SANDBOX_TOKEN=
REFERENCE_APP_URL=http://reference-app:8200

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
